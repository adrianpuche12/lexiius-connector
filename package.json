{
  "name": "lexiius-connector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "build:mcp-exe": "pkg src-tauri/src/lexiius-mcp.js --target node18-win-x64 --output src-tauri/bin/lexiius-mcp-server-x86_64-pc-windows-msvc.exe",
    "tauri:build": "tauri build",
    "test": "jest --testMatch=\"**/tests/**/*.test.cjs\"",
    "test:rust": "cd src-tauri && cargo test",
    "test:all": "npm test && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jest": "^29.7.0",
    "pkg": "^5.8.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.cjs"]
  }
}
